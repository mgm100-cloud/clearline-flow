# Azure backend (Entra + self-hosted PostgREST) — copy to .env.local to activate.
# Leave REACT_APP_BACKEND unset (or 'supabase') to keep the live Supabase path.
# None of these are secrets: tenant/app IDs are public SPA identifiers, the URLs are public.
REACT_APP_BACKEND=azure
REACT_APP_AZURE_POSTGREST_URL=https://clflow-pgrst.azurewebsites.net
REACT_APP_AZURE_TOKENEXCH_URL=https://clflow-tokenexch.azurewebsites.net/exchange
REACT_APP_AZURE_TENANT_ID=36b31f4f-e2a5-422d-a156-ec0be5c4f52f
REACT_APP_AZURE_FLOW_CLIENT_ID=7466cfea-a7e8-4722-9b7d-70b17ecbddb2
# Functions app base URL — the SPA calls these directly (cross-origin/CORS), not via a SWA proxy.
REACT_APP_AZURE_FUNC_URL=https://clflow-func.azurewebsites.net
# Live-price relay (rebroadcasts TwelveData/FMP). Without this the client falls back to a direct
# TwelveData WS that needs a client key and won't subscribe — so live prices go blank.
REACT_APP_WS_SERVER_URL=wss://clprism-relay.azurewebsites.net
